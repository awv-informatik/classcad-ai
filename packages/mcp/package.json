{
  "name": "@awv-informatik/classcad-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for the ClassCAD CAD engine",
  "license": "MIT",
  "type": "module",
  "bin": {
    "classcad-mcp": "dist/server.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-build-assets.mjs",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "postbuild": "node --test test/emission.mjs",
    "test": "npm run build && node test/emission-live.mjs"
  },
  "dependencies": {
    "@classcad/skill": "^0.0.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "sharp": "^0.34.5",
    "ws": "^8.19.0",
    "zod": "^4.4.3",
    "@classcad/renderer": "^0.1.0",
    "@classcad/script": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.0"
  }
}
