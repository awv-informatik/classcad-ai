{
  "name": "@classcad/renderer",
  "version": "0.1.0",
  "description": "Deterministic renderer for ClassCAD session data \u2014 solids (z-buffer, assembly transforms), constrained sketches (dimensions, constraints, label de-overlap), curves, and work geometry. Fixed CAD views (iso/top/front/\u2026), auto-fit, reproducible output. Portable core (browser + Node) with adapters for PNG encoding.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awv-informatik/classcad-renderer.git"
  },
  "keywords": [
    "classcad",
    "buerli",
    "cad",
    "renderer",
    "isometric",
    "snapshot",
    "deterministic",
    "svg",
    "png"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./stl": {
      "types": "./dist/stl.d.ts",
      "default": "./dist/stl.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node test/smoke.mjs && node test/golden.mjs"
  },
  "peerDependencies": {
    "sharp": "^0.34.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "dist/index.d.ts"
}